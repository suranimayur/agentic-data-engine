# ============================================================
# Ola AI Data Agent - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env_sample .env
# ============================================================

# ------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------
host=localhost
port=5432
database=ola_data_agent
user=your_postgres_username
password=your_postgres_password

# ------------------------------------------------------------
# OpenAI API (Required for LLM "low" and "high" tiers)
# Used in: pick_llm("low") -> gpt-5.6-luna
#          pick_llm("high") -> gpt-5.6-terra
# ------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here

# ------------------------------------------------------------
# Ollama (Required for LLM "medium" tier)
# Used in: pick_llm("medium") -> gemma4:e4b
# Make sure Ollama is running locally: ollama serve
# ------------------------------------------------------------
# OLLAMA_HOST=http://localhost:11434
